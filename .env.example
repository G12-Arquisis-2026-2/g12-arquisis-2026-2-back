# Copiar a .env y reemplazar TODOS los valores. Estos valores son de ejemplo y no funcionan.
# Para desarrollo local, ver docs/guia-local.md (RabbitMQ local, sin credenciales reales del broker).

# --- Postgres (contenedor db) ---
POSTGRES_USER=e0
POSTGRES_PASSWORD=cambia-esta-password
POSTGRES_DB=e0_production

# --- Rails ---
RAILS_ENV=production
RAILS_MASTER_KEY=00000000000000000000000000000000
# Hosts públicos permitidos, separados por comas ("web" y "localhost" siempre están permitidos)
ALLOWED_HOSTS=api.sofiaguerrero.me,18.218.169.51
# Debe coincidir con POSTGRES_PASSWORD (config/database.yml lo usa en producción)
E0_DATABASE_PASSWORD=cambia-esta-password
# Base principal. El host "db" es el nombre del servicio en docker-compose.prod.yml
DATABASE_URL=postgres://e0:cambia-esta-password@db:5432/e0_production
# Bases secundarias de Solid Cache / Queue / Cable (database.yml de producción las define aparte)
CACHE_DATABASE_URL=postgres://e0:cambia-esta-password@db:5432/e0_production_cache
QUEUE_DATABASE_URL=postgres://e0:cambia-esta-password@db:5432/e0_production_queue
CABLE_DATABASE_URL=postgres://e0:cambia-esta-password@db:5432/e0_production_cable

# Jobs (orquestador del ciclo) dentro de Puma. docker-compose.prod.yml ya la fija en "true" en el servicio web
SOLID_QUEUE_IN_PUMA=true

# --- Ciclo (E2: 20 minutos) ---
# Mercado de T+0 a T+10, reporte de T+10 a T+15 (validUntil), ciclo siguiente en T+20.
# Si faltan, el código usa los valores de la E1 (120 / 20 / 5), que no sirven para la E2.
CYCLE_LENGTH_MINUTES=20
NEGOTIATION_WINDOW_MINUTES=15
REPORT_PERIOD_MINUTES=5

# --- Connector (RabbitMQ) ---
# En local usar el RabbitMQ del compose: amqp://guest:guest@rabbitmq:5672 (nunca las credenciales reales)
RABBITMQ_URL=amqps://usuario:password-falsa@broker.example.com:5671/vhost
# Debe coincidir con el usuario de RABBITMQ_URL (se usa como propiedad AMQP user_id)
RABBITMQ_USER=city.XX
MASTER_URL=http://web/events
# Cola, exchange y routing keys (reemplazar XX por el código de la ciudad)
QUEUE_NAME=city.XX.q
RABBITMQ_EXCHANGE=energy.x
CITY_ROUTING_KEY=city.XX
CENTRAL_ROUTING_KEY=central
# E2 (contratos iic2173/energyshark-contracts v3.0.2, tabla "Mensajes AMQP"):
# - cola del mercado: market.{CODE} (por omisión market.<CITY_ID>). Ahí llegan offer, offer-updated,
#   offer-withdrawn y market-closed; nunca se responden.
# - a otra ciudad (bid, bid-accepted, bid-rejected, y nuestros ack/nack) se publica en RABBITMQ_EXCHANGE
#   con routing key city.{CODE}: el formato es PEER_ROUTING_KEY_FORMAT (%s = código de la ciudad).
# - nuestra oferta va al exchange market con routing key market.offer.<CITY_ID> (fijo en el código).
MARKET_QUEUE_NAME=market.XX
PEER_ROUTING_KEY_FORMAT=city.%s
# Obsoleto: solo se usa si QUEUE_NAME no está definida (cola "observer.<id>.q")
OBSERVER_ID=00
# Interruptor de publicación hacia la central, otras ciudades y el mercado. Solo "true" publica; con cualquier
# otro valor el connector solo loguea lo que habría publicado y los pendientes del outbox siguen pendientes.
ENABLE_PUBLISHER=false

# --- Ciudad ---
CITY_ID=XX
CITY_NAME=Nombre-de-la-ciudad

# --- Wallet (E2) ---
# URL de la API de la wallet, terminada en /v1 (el JWKS se busca en la raíz del dominio: /.well-known/jwks.json)
WALLET_URL=https://wallet.example.com/v1
# API key de la ciudad entregada por el curso. Secreto: si se filtra, pedir rotación de inmediato
CITY_API_KEY=cambia-esta-clave

# --- CORS (orígenes permitidos del front, separados por comas) ---
CORS_ORIGINS=https://app.example.com,http://localhost:5173

# --- New Relic APM (Ruby) ---
NEW_RELIC_LICENSE_KEY=cambia-esta-clave
NEW_RELIC_APP_NAME=energyshark-back
NEW_RELIC_LOG=stdout

# Registro de imágenes (ECR). Opcional: si no se define, usa el de nuestra cuenta (us-east-2).
# ECR_REGISTRY=624005845126.dkr.ecr.us-east-2.amazonaws.com
