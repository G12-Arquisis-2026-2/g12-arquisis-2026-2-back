# Copiar a .env y reemplazar TODOS los valores. Estos valores son de ejemplo y no funcionan.

# --- Postgres (contenedor db) ---
POSTGRES_USER=e0
POSTGRES_PASSWORD=cambia-esta-password
POSTGRES_DB=e0_production

# --- Rails ---
RAILS_ENV=production
RAILS_MASTER_KEY=00000000000000000000000000000000
# Hosts públicos permitidos, separados por comas ("web" y "localhost" siempre están permitidos)
ALLOWED_HOSTS=api.sofiaguerrero.me,18.218.169.51
# Debe coincidir con POSTGRES_PASSWORD (config/database.yml lo usa en producción)
E0_DATABASE_PASSWORD=cambia-esta-password
# Base principal. El host "db" es el nombre del servicio en docker-compose.prod.yml
DATABASE_URL=postgres://e0:cambia-esta-password@db:5432/e0_production
# Bases secundarias de Solid Cache / Queue / Cable (database.yml de producción las define aparte)
CACHE_DATABASE_URL=postgres://e0:cambia-esta-password@db:5432/e0_production_cache
QUEUE_DATABASE_URL=postgres://e0:cambia-esta-password@db:5432/e0_production_queue
CABLE_DATABASE_URL=postgres://e0:cambia-esta-password@db:5432/e0_production_cable

# --- Connector ---
RABBITMQ_URL=amqps://usuario:password-falsa@broker.example.com:5671/vhost
OBSERVER_ID=00
MASTER_URL=http://web/events
# Cola, exchange y routing keys de RabbitMQ (reemplazar XX por el número de la ciudad)
QUEUE_NAME=city.XX.q
RABBITMQ_EXCHANGE=energy.x
CITY_ROUTING_KEY=city.XX
CENTRAL_ROUTING_KEY=central
